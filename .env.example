APP_NAME=SiedeStudios
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=siedestudios
# DB_USERNAME=siedestudios
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@siedestudios.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Discord OAuth (admin login) — create an app at https://discord.com/developers/applications
# and add {APP_URL}/auth/discord/callback as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Comma-separated Discord user IDs allowed into /admin (more can be added in Settings → Access).
ADMIN_DISCORD_IDS=

# Inertia server-side rendering is not used.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
